---
layout: main
---
<div class="post">
<header class="post-header">
 <h1 class="post-title"> {{ title }}</h1> 
 	<p class="post-meta"> Created on {% formatDate date %}</p> 
	<p class="post-tags"> 
	{% for cat in categories %}
	<a href="/categories/{{ cat | slugify }}">
	<i class="fa-solid fa-hashtag fa-sm"></i> {{ cat }}
	</a>{% if not loop.last %} · {% endif %}
	{% endfor %}
</p>
<header>
<article class="post-content">
{{ content | safe }}
</article>
</div>